     interactive();
-  else {
+  else
+  {
+    // Preserve normal Spike behaviour unless a SystemC callback is installed.
+    // In co-simulation mode one idle() call represents one 1 GHz CPU cycle.
+    const size_t quantum = systemc_step_callback ? 1 : INTERLEAVE;
+
     if (instruction_limit.has_value()) {
-      if (*instruction_limit < INTERLEAVE) {
+      if (*instruction_limit < quantum) {
